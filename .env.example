# Public build-time configuration. Copy to .env for local development; CI reads these from
# GitHub repository variables. All values end up in the public HTML.

# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
PUBLIC_CONTACT_FORM_ENDPOINT=

# Cloudflare Turnstile site key for andrewsunada.com (the secret key lives in Formspree, never here)
PUBLIC_TURNSTILE_SITE_KEY=

# Optional Google Search Console verification token
PUBLIC_GOOGLE_SITE_VERIFICATION=
